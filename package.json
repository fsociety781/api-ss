    "debug": "^4.4.0",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.0.0",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
