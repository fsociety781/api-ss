# ========================================================
# 🍄 SHROOMSYNC — DOCKER PRODUCTION ENVIRONMENT
# ========================================================
# Salin file ini menjadi .env di server production Anda:
#   cp .env.docker.example .env

# --------------------------------------------------------
# 1. DATABASE POSTGRESQL (Container)
# --------------------------------------------------------
POSTGRES_USER=shroom_admin
POSTGRES_PASSWORD=GantiDenganPasswordDatabaseYangKuat123!
POSTGRES_DB=shroomsync_db

# --------------------------------------------------------
# 2. SERVER PUBLIC DOMAIN / IP
# --------------------------------------------------------
# URL domain publik server atau IP publik VPS Anda.
# PENTING: Digunakan oleh ESP32-S3 untuk mengunduh firmware update (.bin)
# Contoh domain: PUBLIC_API_URL=https://api.shroomsync.com
# Contoh IP:     PUBLIC_API_URL=http://103.xxx.xxx.xxx:3000
PUBLIC_API_URL=http://localhost:3000

# --------------------------------------------------------
# 3. KEAMANAN & TOKEN JWT
# --------------------------------------------------------
# Ganti dengan string acak yang panjang dan aman
JWT_SECRET=shroomsync-super-secret-random-production-key-2026!
JWT_EXPIRES_IN=7d

# --------------------------------------------------------
# 4. MQTT BROKER
# --------------------------------------------------------
# Gunakan broker EMQX internal di docker atau broker cloud:
# - Broker EMQX Docker internal: mqtt://emqx:1883
# - Broker EMQX Public:          mqtt://broker.emqx.io:1883
MQTT_BROKER_URL=mqtt://emqx:1883

# --------------------------------------------------------
# 5. KREDENSIAL AWAL AKUN TEKNISI (Auto-seed saat pertama jalan)
# --------------------------------------------------------
DEFAULT_TECHNICIAN_EMAIL=technician@shroomsync.id
DEFAULT_TECHNICIAN_PASSWORD=ShroomSyncTech2026!

# --------------------------------------------------------
# 6. PENGATURAN LAINNYA
# --------------------------------------------------------
CORS_ORIGIN=*
LOG_LEVEL=info
