# ========================================================
# 🍄 SHROOMSYNC BACKEND — ENVIRONMENT TEMPLATE
# ========================================================

NODE_ENV="development"
PORT=3000

# --------------------------------------------------------
# 1. DATABASE POSTGRESQL (Prisma v7)
# --------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shroomsync?schema=public"
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shroomsync?schema=public"

# --------------------------------------------------------
# 2. MQTT BROKER (EMQX)
# --------------------------------------------------------
# Pilihan 1 - EMQX Public Sandbox (Langsung pakai tanpa install broker):
#   MQTT_BROKER_URL="mqtt://broker.emqx.io:1883"
# Pilihan 2 - EMQX Lokal / Docker (Default port EMQX 1883):
#   MQTT_BROKER_URL="mqtt://localhost:1883"
# Pilihan 3 - EMQX Cloud Serverless (Mendukung SSL/TLS port 8883):
#   MQTT_BROKER_URL="mqtts://xxxxxx.emqx.cloud:8883"
MQTT_BROKER_URL="mqtt://broker.emqx.io:1883"
MQTT_CLIENT_ID="shroomsync-api-server"
MQTT_USERNAME=""
MQTT_PASSWORD=""

# --------------------------------------------------------
# 3. KEAMANAN & TOKEN JWT
# --------------------------------------------------------
JWT_SECRET="shroomsync-dev-super-secret-jwt-key-2026!"
JWT_EXPIRES_IN="7d"

# --------------------------------------------------------
# 4. KREDENSIAL AWAL AKUN TEKNISI (Otomatis dibuat saat boot)
# --------------------------------------------------------
DEFAULT_TECHNICIAN_NAME="Teknisi ShroomSync"
DEFAULT_TECHNICIAN_PHONE="08111111111"
DEFAULT_TECHNICIAN_EMAIL="technician@shroomsync.id"
DEFAULT_TECHNICIAN_PASSWORD="Password123!"

# --------------------------------------------------------
# 5. CORS & RATE LIMITING
# --------------------------------------------------------
CORS_ORIGIN="*"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# --------------------------------------------------------
# 6. LOGGING LEVEL (debug | info | warn | error)
# --------------------------------------------------------
LOG_LEVEL="info"
