# ========================================================
# 🍄 SHROOMSYNC IOT BACKEND — ENVIRONMENT CONFIGURATION
# ========================================================

# Application Runtime Environment (development | test | production)
NODE_ENV=development

# HTTP Service Port
PORT=3000

# PostgreSQL Connection String (Prisma 7 / pg Driver Adapter)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shroomsync_db?schema=public"

# JSON Web Token (JWT) Security
# IMPORTANT: Generate a strong secret string in production (min 32 characters)
JWT_SECRET="shroomsync-dev-super-secret-jwt-key-2026!"
JWT_EXPIRES_IN="7d"

# MQTT Broker Connection (ESP32 IoT Nodes Communication)
MQTT_BROKER_URL="mqtt://localhost:1883"
MQTT_CLIENT_ID="shroomsync-api-server"
MQTT_USERNAME=""
MQTT_PASSWORD=""

# Default Technician Initial Account (Auto-created on first bootstrap)
DEFAULT_TECHNICIAN_NAME="Head Technician ShroomSync"
DEFAULT_TECHNICIAN_PHONE="08111111111"
DEFAULT_TECHNICIAN_EMAIL="technician@shroomsync.id"
DEFAULT_TECHNICIAN_PASSWORD="Password123!"

# CORS Allowed Origins (Comma-separated for multiple domains, or * for all)
CORS_ORIGIN="*"

# Rate Limiting Protection (Brute Force & DoS Prevention)
RATE_LIMIT_WINDOW_MS=900000     # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=300     # Maximum requests per IP window

# Logging Level (debug | info | warn | error)
LOG_LEVEL="info"

