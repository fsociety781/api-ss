generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =====================================================
// USER
// =====================================================

model User {
  id           String  @id @default(cuid())
  fullName     String?
  phoneNumber  String  @unique
  email        String? @unique
  passwordHash String?

  role               UserRole   @default(FARMER)
  status             UserStatus @default(INVITED)
  profileCompleted   Boolean    @default(false)
  mustChangePassword Boolean    @default(false)

  createdById  String?
  createdBy    User?   @relation("UserCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[]  @relation("UserCreator")

  devices        Device[] @relation("FarmerDevices")
  createdDevices Device[] @relation("DeviceCreator")

  controlLogs ControlLog[]
  schedules   Schedule[]

  activatedAt DateTime?
  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([status])
  @@index([createdById])
  @@map("users")
}

// =====================================================
// DEVICE
// =====================================================

model Device {
  id             String @id @default(cuid())
  serialNumber   String @unique
  activationCode String @unique

  name            String?
  model           String
  hardwareVersion String?
  firmwareVersion String?

  status        DeviceStatus  @default(READY)
  ownershipType OwnershipType @default(RENTED)
  controlMode   ControlMode   @default(MANUAL)

  farmerId String?
  farmer   User?   @relation("FarmerDevices", fields: [farmerId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("DeviceCreator", fields: [createdById], references: [id], onDelete: SetNull)

  setting        DeviceSetting?
  sensorReadings SensorReading[]
  actuators      Actuator[]
  controlLogs       ControlLog[]
  schedules         Schedule[]
  cultivationCycles CultivationCycle[]

  activatedAt DateTime?
  lastSeenAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmerId])
  @@index([createdById])
  @@index([status])
  @@map("devices")
}

// =====================================================
// SETPOINT DAN KONFIGURASI
// =====================================================

model DeviceSetting {
  id       String @id @default(cuid())
  deviceId String @unique

  minTemperature Decimal? @db.Decimal(5, 2)
  maxTemperature Decimal? @db.Decimal(5, 2)

  minHumidity Decimal? @db.Decimal(5, 2)
  maxHumidity Decimal? @db.Decimal(5, 2)

  timerDurationSeconds Int?

  telemetryIntervalSec Int @default(60)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("device_settings")
}

// =====================================================
// DATA SUHU DAN KELEMBAPAN
// =====================================================

model SensorReading {
  id       BigInt @id @default(autoincrement())
  deviceId String

  temperature Decimal @db.Decimal(5, 2)
  humidity    Decimal @db.Decimal(5, 2)

  recordedAt DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, recordedAt])
  @@map("sensor_readings")
}

// =====================================================
// AKTUATOR
// =====================================================

model Actuator {
  id       String @id @default(cuid())
  deviceId String

  name    String
  type    ActuatorType
  channel Int

  state     ActuatorState @default(OFF)
  isEnabled Boolean       @default(true)

  lastChangedAt DateTime?

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  controlLogs ControlLog[]
  schedules   Schedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([deviceId, channel])
  @@index([deviceId])
  @@map("actuators")
}

// =====================================================
// RIWAYAT KONTROL
// =====================================================

model ControlLog {
  id         BigInt  @id @default(autoincrement())
  deviceId   String
  actuatorId String?
  userId     String?

  action ControlAction
  source ControlSource
  mode   ControlMode

  success Boolean @default(false)
  message String?

  requestedAt DateTime  @default(now())
  executedAt  DateTime?

  device   Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  actuator Actuator? @relation(fields: [actuatorId], references: [id], onDelete: SetNull)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([deviceId, requestedAt])
  @@index([actuatorId])
  @@index([userId])
  @@map("control_logs")
}

// =====================================================
// JADWAL
// =====================================================

model Schedule {
  id          String @id @default(cuid())
  deviceId    String
  actuatorId  String
  createdById String

  name   String
  action ControlAction @default(TURN_ON)

  startMinute     Int
  durationSeconds Int?
  daysOfWeek      Int[]

  isEnabled Boolean @default(true)

  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  actuator  Actuator @relation(fields: [actuatorId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deviceId])
  @@index([actuatorId])
  @@index([createdById])
  @@index([isEnabled])
  @@map("schedules")
}

// =====================================================
// SIKLUS BUDIDAYA JAMUR (CULTIVATION CYCLES)
// =====================================================

model CultivationCycle {
  id              String    @id @default(cuid())
  deviceId        String
  device          Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  name            String?
  mushroomType    String    @default("Jamur Tiram")
  strain          String?
  baglogCount     Int?
  startedAt       DateTime  @default(now())
  expectedEndedAt DateTime?
  endedAt         DateTime?
  status          String    @default("active")
  notes           String?

  harvests HarvestRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deviceId, status, startedAt])
  @@map("cultivation_cycles")
}

// =====================================================
// CATATAN PANEN (HARVEST RECORDS)
// =====================================================

model HarvestRecord {
  id          String           @id @default(cuid())
  cycleId     String
  cycle       CultivationCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  harvestedAt DateTime         @default(now())
  weightKg    Decimal          @db.Decimal(8, 2)
  pricePerKg  Decimal?         @db.Decimal(12, 2)
  grade       String?
  notes       String?

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([cycleId, harvestedAt])
  @@map("harvest_records")
}

// =====================================================
// ENUM
// =====================================================

enum UserRole {
  TECHNICIAN
  ADMIN
  FARMER
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum DeviceStatus {
  READY
  ACTIVE
  OFFLINE
  SUSPENDED
  MAINTENANCE
}

enum OwnershipType {
  OWNED
  RENTED
  LEASED
}

enum ControlMode {
  MANUAL
  AUTO
  HYBRID
  SCHEDULE
}

enum ActuatorType {
  FLOOR
  PUMP
  MISTING
  FLOOR_WATERING
  LIGHT
  OTHER
}

enum ActuatorState {
  ON
  OFF
  UNKNOWN
}

enum ControlAction {
  TURN_ON
  TURN_OFF
}

enum ControlSource {
  MOBILE_APP
  WEB_DASHBOARD
  AUTOMATION
  SCHEDULE
  DEVICE
  TECHNICIAN
}
